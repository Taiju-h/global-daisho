// AI Chat Widget for Daisho Chemical GLOBAL - Site-wide injection
(function () {
    'use strict';

    // Multi-language dictionary for UI text - All nine ISO codes
    const labels = {
        en: {
            title: 'Daisho Chemical AI Assistant',
            placeholder: 'Ask me anything…',
            typing: 'AI is typing...',
            send: 'Send',
            close: 'Close',
            welcomeMessage: 'Hello! How can I help you today?'
        },
        ja: {
            title: 'ダイショー化学AIアシスタント',
            placeholder: '何でも聞いてください…',
            typing: 'AIが入力中...',
            send: '送信',
            close: '閉じる',
            welcomeMessage: 'こんにちは！どのようなご質問でしょうか？'
        },
        zh: {
            title: '大正化学AI助手',
            placeholder: '请随时提问…',
            typing: 'AI正在输入...',
            send: '发送',
            close: '关闭',
            welcomeMessage: '您好！我可以为您提供什么帮助？'
        },
        ko: {
            title: '다이쇼 케미칼 AI 어시스턴트',
            placeholder: '무엇이든 물어보세요…',
            typing: 'AI가 입력 중...',
            send: '보내기',
            close: '닫기',
            welcomeMessage: '안녕하세요! 어떻게 도와드릴까요?'
        },
        de: {
            title: 'Daisho Chemical KI-Assistent',
            placeholder: 'Fragen Sie mich alles…',
            typing: 'KI tippt...',
            send: 'Senden',
            close: 'Schließen',
            welcomeMessage: 'Hallo! Wie kann ich Ihnen helfen?'
        },
        fr: {
            title: 'Assistant IA Daisho Chemical',
            placeholder: 'Demandez-moi tout…',
            typing: 'IA tape...',
            send: 'Envoyer',
            close: 'Fermer',
            welcomeMessage: 'Bonjour! Comment puis-je vous aider?'
        },
        es: {
            title: 'Asistente IA Daisho Chemical',
            placeholder: 'Pregúntame cualquier cosa…',
            typing: 'IA está escribiendo...',
            send: 'Enviar',
            close: 'Cerrar',
            welcomeMessage: '¡Hola! ¿Cómo puedo ayudarte?'
        },
        it: {
            title: 'Assistente AI Daisho Chemical',
            placeholder: 'Chiedimi qualsiasi cosa…',
            typing: 'IA sta scrivendo...',
            send: 'Invia',
            close: 'Chiudi',
            welcomeMessage: 'Ciao! Come posso aiutarti?'
        },
        pt: {
            title: 'Assistente IA Daisho Chemical',
            placeholder: 'Pergunte-me qualquer coisa…',
            typing: 'IA está digitando...',
            send: 'Enviar',
            close: 'Fechar',
            welcomeMessage: 'Olá! Como posso ajudar?'
        }
    };

    // Global widget instance
    let daishoChatWidget = null;

    class DaishoChatWidget {
        constructor() {
            // Get language from document.documentElement.lang
            this.lang = document.documentElement.lang || 'en';

            // Fallback to English if language not supported
            if (!labels[this.lang]) {
                this.lang = 'en';
            }

            this.socket = null;
            this.isOpen = false;
            this.chatElement = null;
            this.messagesContainer = null;
            this.inputField = null;
            this.sendButton = null;

            this.init();
        }

        init() {
            this.createStyles();
            this.createChatElement();
            this.connectSocket();
            this.setupEventListeners();
        }

        // Create CSS styles for the widget
        createStyles() {
            const style = document.createElement('style');
            style.textContent = `
                #daisho-chat {
                    position: fixed;
                    bottom: 20px;
                    right: 20px;
                    z-index: 10000;
                    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                }

                .daisho-chat-bubble {
                    width: 60px;
                    height: 60px;
                    background: linear-gradient(135deg, #2563eb, #1d4ed8);
                    border-radius: 50%;
                    color: white;
                    font-size: 24px;
                    cursor: pointer;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    box-shadow: 0 4px 16px rgba(37, 99, 235, 0.3);
                    transition: all 0.3s ease;
                    border: none;
                    padding: 0;
                    overflow: hidden;
                }

                .daisho-chat-bubble:hover {
                    transform: scale(1.1);
                    box-shadow: 0 6px 20px rgba(37, 99, 235, 0.4);
                }

                .daisho-agent-avatar {
                         width: 72px;
                         height: 72px;
                         border-radius: 50%;
                         object-fit: cover;
                         object-position: 50% 15%;
                         border: 2.5px solid #fff;
                         background: #fff;
                         display: block;
                }
                .daisho-chat-window {
                    position: absolute;
                    bottom: 80px;
                    right: 0;
                    width: 525px;
                    height: 750px;
                    background: white;
                    border-radius: 12px;
                    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
                    border: 1px solid #e1e5e9;
                    display: none;
                    flex-direction: column;
                    animation: slideUp 0.3s ease-out;
                }

                .daisho-chat-window.open {
                    display: flex;
                }

                @keyframes slideUp {
                    from {
                        transform: translateY(20px);
                        opacity: 0;
                    }
                    to {
                        transform: translateY(0);
                        opacity: 1;
                    }
                }

                .daisho-chat-header {
                    background: linear-gradient(135deg, #2563eb, #1d4ed8);
                    color: white;
                    padding: 16px;
                    border-radius: 12px 12px 0 0;
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                }

                .daisho-chat-title {
                    font-weight: 600;
                    font-size: 16px;
                }

                .daisho-chat-close {
                    background: none;
                    border: none;
                    color: white;
                    font-size: 20px;
                    cursor: pointer;
                    padding: 0;
                    width: 24px;
                    height: 24px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    border-radius: 4px;
                    transition: background 0.2s;
                }

                .daisho-chat-close:hover {
                    background: rgba(255, 255, 255, 0.1);
                }

                .daisho-chat-messages {
                    flex: 1;
                    overflow-y: auto;
                    padding: 16px;
                    display: flex;
                    flex-direction: column;
                    gap: 12px;
                }

                .daisho-message {
                    max-width: 85%;
                    padding: 12px 16px;
                    border-radius: 18px;
                    font-size: 14px;
                    line-height: 1.4;
                    word-wrap: break-word;
                }

                .daisho-message.user {
                    background: #2563eb;
                    color: white;
                    align-self: flex-end;
                    border-bottom-right-radius: 4px;
                }

                .daisho-message.bot {
                    background: #f3f4f6;
                    color: #374151;
                    align-self: flex-start;
                    border-bottom-left-radius: 4px;
                }

                .daisho-message.error {
                    background: #fee2e2;
                    color: #991b1b;
                    align-self: flex-start;
                    border-bottom-left-radius: 4px;
                }

                .daisho-typing {
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    padding: 12px 16px;
                    color: #6b7280;
                    font-size: 14px;
                    align-self: flex-start;
                }

                .daisho-typing-dots {
                    display: flex;
                    gap: 4px;
                }

                .daisho-typing-dot {
                    width: 6px;
                    height: 6px;
                    background: #6b7280;
                    border-radius: 50%;
                    animation: daisho-typing 1.4s infinite;
                }

                .daisho-typing-dot:nth-child(2) {
                    animation-delay: 0.2s;
                }

                .daisho-typing-dot:nth-child(3) {
                    animation-delay: 0.4s;
                }

                @keyframes daisho-typing {
                    0%, 60%, 100% {
                        opacity: 0.3;
                    }
                    30% {
                        opacity: 1;
                    }
                }

                .daisho-chat-input {
                    padding: 16px;
                    border-top: 1px solid #e5e7eb;
                    display: flex;
                    gap: 8px;
                    align-items: center;
                }

                .daisho-chat-input input {
                    flex: 1;
                    padding: 12px 16px;
                    border: 1px solid #d1d5db;
                    border-radius: 24px;
                    font-size: 14px;
                    outline: none;
                    transition: border-color 0.2s;
                }

                .daisho-chat-input input:focus {
                    border-color: #2563eb;
                }

                .daisho-send-button {
                    background: #2563eb;
                    color: white;
                    border: none;
                    width: 40px;
                    height: 40px;
                    border-radius: 50%;
                    cursor: pointer;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    transition: background 0.2s;
                }

                .daisho-send-button:hover {
                    background: #1d4ed8;
                }

                .daisho-send-button:disabled {
                    background: #9ca3af;
                    cursor: not-allowed;
                }

                /* Mobile responsive */
                @media (max-width: 768px) {
                    .daisho-chat-window {
                        width: 462px;
                        height: 650px;
                    }
                    
                    #daisho-chat {
                        bottom: 15px;
                        right: 15px;
                    }
                }
            `;
            document.head.appendChild(style);
        }

        // Create the floating chat bubble element
        createChatElement() {
            const ui = labels[this.lang];

            // Create main container
            this.chatElement = document.createElement('div');
            this.chatElement.id = 'daisho-chat';

            // Create chat bubble (now with agent image)
            const bubble = document.createElement('button');
            bubble.className = 'daisho-chat-bubble';
            bubble.innerHTML = '<img src="/client/agent_bubble1.jpg" alt="Agent" class="daisho-agent-avatar">';
            bubble.setAttribute('aria-label', ui.title);

            // Create chat window
            const window = document.createElement('div');
            window.className = 'daisho-chat-window';
            window.innerHTML = `
                <div class="daisho-chat-header">
                    <div class="daisho-chat-title">${ui.title}</div>
                    <button class="daisho-chat-close" aria-label="${ui.close}">&times;</button>
                </div>
                <div class="daisho-chat-messages"></div>
                <div class="daisho-chat-input">
                    <input type="text" placeholder="${ui.placeholder}" maxlength="500">
                    <button class="daisho-send-button" aria-label="${ui.send}">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                        </svg>
                    </button>
                </div>
            `;

            // Append elements
            this.chatElement.appendChild(bubble);
            this.chatElement.appendChild(window);
            document.body.appendChild(this.chatElement);

            // Store references
            this.chatBubble = bubble;
            this.chatWindow = window;
            this.messagesContainer = window.querySelector('.daisho-chat-messages');
            this.inputField = window.querySelector('.daisho-chat-input input');
            this.sendButton = window.querySelector('.daisho-send-button');
            this.closeButton = window.querySelector('.daisho-chat-close');
        }

        // Connect to Socket.IO at your domain
        connectSocket() {
            // Try to connect to the current domain first, fallback to localhost:3001
            const serverUrl = window.location.protocol + '//' + window.location.host;

            this.socket = io(serverUrl, {
                transports: ['websocket', 'polling'],
                timeout: 5000
            });

            this.socket.on('connect', () => {
                console.log('Connected to Daisho Chemical chat server');
                this.showWelcomeMessage();
            });

            this.socket.on('disconnect', () => {
                console.log('Disconnected from chat server');
            });

            this.socket.on('connect_error', (error) => {
                console.warn('Failed to connect to chat server:', error);
                // Fallback to localhost for development
                if (serverUrl !== 'http://localhost:3001') {
                    this.connectToFallback();
                }
            });

            // Listen for botMessage events
            this.socket.on('botMessage', (data) => {
                this.hideTypingIndicator();
                this.addMessage(data.reply, data.error ? 'error' : 'bot');
                this.sendButton.disabled = false;
            });
        }

        // Fallback connection for development
        connectToFallback() {
            console.log('Attempting fallback connection to localhost:3001');
            this.socket = io('http://localhost:3001');

            this.socket.on('connect', () => {
                console.log('Connected to development chat server');
                this.showWelcomeMessage();
            });

            this.socket.on('botMessage', (data) => {
                this.hideTypingIndicator();
                this.addMessage(data.reply, data.error ? 'error' : 'bot');
                this.sendButton.disabled = false;
            });
        }

        // Setup event listeners
        setupEventListeners() {
            // Chat bubble click - expand to chat window
            this.chatBubble.addEventListener('click', () => {
                this.openChat();
            });

            // Close button
            this.closeButton.addEventListener('click', () => {
                this.closeChat();
            });

            // Send button
            this.sendButton.addEventListener('click', () => {
                this.sendMessage();
            });

            // Enter key in input
            this.inputField.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    this.sendMessage();
                }
            });

            // Click outside to close
            document.addEventListener('click', (e) => {
                if (this.isOpen && !this.chatElement.contains(e.target)) {
                    this.closeChat();
                }
            });
        }

        // Open chat window
        openChat() {
            this.isOpen = true;
            this.chatWindow.classList.add('open');
            this.chatBubble.style.display = 'none';
            setTimeout(() => {
                this.inputField.focus();
            }, 100);
        }

        // Close chat window
        closeChat() {
            this.isOpen = false;
            this.chatWindow.classList.remove('open');
            this.chatBubble.style.display = 'flex';
        }

        // Send message via Socket.IO
        sendMessage() {
            const message = this.inputField.value.trim();
            if (!message || this.sendButton.disabled) return;

            // Append user text to the chat log
            this.addMessage(message, 'user');
            this.inputField.value = '';
            this.sendButton.disabled = true;

            // Show typing indicator
            this.showTypingIndicator();

            // Emit userMessage via Socket.IO
            this.socket.emit('userMessage', {
                msg: message,
                lang: this.lang
            });
        }

        // Add message to chat log
        addMessage(text, type) {
            const messageDiv = document.createElement('div');
            messageDiv.className = `daisho-message ${type}`;
            messageDiv.textContent = text;

            this.messagesContainer.appendChild(messageDiv);
            this.messagesContainer.scrollTop = this.messagesContainer.scrollHeight;
        }

        // Show typing indicator
        showTypingIndicator() {
            this.hideTypingIndicator();

            const ui = labels[this.lang];
            const typingDiv = document.createElement('div');
            typingDiv.className = 'daisho-typing';
            typingDiv.innerHTML = `
                <span>${ui.typing}</span>
                <div class="daisho-typing-dots">
                    <div class="daisho-typing-dot"></div>
                    <div class="daisho-typing-dot"></div>
                    <div class="daisho-typing-dot"></div>
                </div>
            `;

            this.messagesContainer.appendChild(typingDiv);
            this.messagesContainer.scrollTop = this.messagesContainer.scrollHeight;
        }

        // Hide typing indicator
        hideTypingIndicator() {
            const typingIndicator = this.messagesContainer.querySelector('.daisho-typing');
            if (typingIndicator) {
                typingIndicator.remove();
            }
        }

        // Show welcome message
        showWelcomeMessage() {
            const ui = labels[this.lang];
            setTimeout(() => {
                this.addMessage(ui.welcomeMessage, 'bot');
            }, 1000);
        }
    }

    // Initialize widget when DOM is ready
    function initWidget() {
        if (daishoChatWidget) return; // Prevent multiple instances

        daishoChatWidget = new DaishoChatWidget();

        // Expose globally for debugging
        window.daishoChatWidget = daishoChatWidget;
    }

    // Auto-initialize when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initWidget);
    } else {
        initWidget();
    }

})();