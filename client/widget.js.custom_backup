    // Global widget instance
    let daishoChatWidget = null;

    class DaishoChatWidget {
        constructor() {
            // Get language from document.documentElement.lang
            this.lang = document.documentElement.lang || 'en';

            // Fallback to English if language not supported
            if (!labels[this.lang]) {
                this.lang = 'en';
            }

            this.socket = null;
            this.isOpen = false;
            this.chatElement = null;
            this.messagesContainer = null;
            this.inputField = null;
            this.sendButton = null;
            this.hasInteracted = false;
            this.hasSentFirstMessage = false;
            this.sessionId = this.generateSessionId();
            this.userId = this.getUserId();

            this.init();
        }

        // Generate unique session ID
        generateSessionId() {
            return 'session_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
        }

        // Get or create user ID (stored in localStorage)
        getUserId() {
            let userId = localStorage.getItem('daisho_user_id');
            if (!userId) {
                userId = 'user_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
                localStorage.setItem('daisho_user_id', userId);
            }
            return userId;
        }

        // Log events to database
        logEvent(eventType, data) {
            const logData = {
                sessionId: this.sessionId,
                userId: this.userId,
                eventType: eventType,
                timestamp: new Date().toISOString(),
                language: this.lang,
                userAgent: navigator.userAgent,
                url: window.location.href,
                ...data
            };

            // Send to server for database storage
            if (this.socket && this.socket.connected) {
                this.socket.emit('logEvent', logData);
            } else {
                // Fallback: store in localStorage and send later
                const pendingLogs = JSON.parse(localStorage.getItem('daisho_pending_logs') || '[]');
                pendingLogs.push(logData);
                localStorage.setItem('daisho_pending_logs', JSON.stringify(pendingLogs));
            }

            // Console log for debugging
            console.log('Daisho Chat Event:', logData);
        }

        // Send pending logs when connection is established
        sendPendingLogs() {
            const pendingLogs = JSON.parse(localStorage.getItem('daisho_pending_logs') || '[]');
            if (pendingLogs.length > 0) {
                pendingLogs.forEach(logData => {
                    this.socket.emit('logEvent', logData);
                });
                localStorage.removeItem('daisho_pending_logs');
            }
        }

