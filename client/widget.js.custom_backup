        renderPresetQuestions() {
            const ui = labels[this.lang];
            this.presetQuestionsContainer.innerHTML = '';
        
            ui.presetQuestions.forEach((question) => {
                const presetQuestion = document.createElement('div');
                presetQuestion.className = 'preset-question';
                presetQuestion.textContent = question;
                presetQuestion.tabIndex = 0; // keyboard accessibility
                presetQuestion.setAttribute('role', 'button');
                presetQuestion.setAttribute('aria-label', question);
        
                const askPreset = () => {
                    this.hidePresetQuestions();
                    this.addMessage(question, 'user');
                    this.inputField.value = '';
                    this.sendButton.disabled = true;
                    this.showTypingIndicator();
        
                    // Log preset question selection
                    this.logEvent('preset_question_selected', {
                        message: question,
                        questionIndex: ui.presetQuestions.indexOf(question),
                        messageLength: question.length
                    });
        
                    // Lookup the answer from presetAnswers
                    const answerIndex = ui.presetQuestions.indexOf(question);
                    if (answerIndex !== -1) {
                        const answer = ui.presetAnswers[answerIndex];
                        this.addMessage(answer, 'bot');
                        this.hideTypingIndicator();
                    }
        
                    // ↓ AIへは送らないようにコメントアウト
                    // this.socket.emit('userMessage', {
                    //     msg: question,
                    //     lang: this.lang
                    // });
                    // this.hasSentFirstMessage = true;
                };
        
                presetQuestion.addEventListener('click', askPreset);
                presetQuestion.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' || e.key === ' ') {
                        askPreset();
                        e.preventDefault();
                    }
                });
        
                this.presetQuestionsContainer.appendChild(presetQuestion);
            });
        }
        

        // Connect to Socket.IO at your domain
        connectSocket() {
            // Try to connect to the current domain first, fallback to localhost:3001
            const serverUrl = window.location.protocol + '//' + window.location.host;

            this.socket = io(serverUrl, {
                transports: ['websocket', 'polling'],
                timeout: 5000
            });

            this.socket.on('connect', () => {
                console.log('Connected to Daisho Chemical chat server');
                    this.showWelcomeMessage();

                this.logEvent('connection_established', {
                    serverUrl: serverUrl,
                    connectionTime: new Date().toISOString()
                });
                this.sendPendingLogs();
            });

            this.socket.on('disconnect', () => {
                console.log('Disconnected from chat server');
                this.logEvent('connection_lost', {
                    disconnectionTime: new Date().toISOString()
                });
            });

            this.socket.on('connect_error', (error) => {
                console.warn('Failed to connect to chat server:', error);
                this.logEvent('connection_error', {
                    error: error.message,
                    serverUrl: serverUrl
                });
                // Fallback to localhost for development
                if (serverUrl !== 'http://localhost:3001') {
                    this.connectToFallback();
                }
            });

            // Listen for botMessage events
            this.socket.on('botMessage', (data) => {
                this.hideTypingIndicator();
                this.addMessage(data.reply, data.error ? 'error' : 'bot');
                this.sendButton.disabled = false;

                // Log bot response
                this.logEvent('bot_response', {
                    message: data.reply,
                    hasError: !!data.error,
                    responseTime: new Date().toISOString(),
                    messageLength: data.reply.length
                });
            });
        }

        // Fallback connection for development
        connectToFallback() {
            console.log('Attempting fallback connection to localhost:3001');
            this.socket = io('http://localhost:3001');

            this.socket.on('connect', () => {
                this.showWelcomeMessage();

                console.log('Connected to development chat server');
                this.logEvent('fallback_connection_established', {
                    serverUrl: 'http://localhost:3001'
                });
                this.sendPendingLogs();
            });

            this.socket.on('botMessage', (data) => {
                this.hideTypingIndicator();
                this.addMessage(data.reply, data.error ? 'error' : 'bot');
                this.sendButton.disabled = false;

                // Log bot response
                this.logEvent('bot_response', {
                    message: data.reply,
                    hasError: !!data.error,
                    responseTime: new Date().toISOString(),
                    messageLength: data.reply.length
                });
            });
        }

        // Setup event listeners
        setupEventListeners() {
            // Chat bubble click - expand to chat window
            this.chatBubble.addEventListener('click', () => {
                this.openChat();
            });

            // Close button
            this.closeButton.addEventListener('click', () => {
                this.closeChat();
            });

            // Send button
            this.sendButton.addEventListener('click', () => {
                this.sendMessage();
            });

            // Enter key in input
            this.inputField.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    this.sendMessage();
                }
            });

            // Show preset questions when user interacts with input
            this.inputField.addEventListener('focus', () => {
                if (!this.hasInteracted && !this.hasSentFirstMessage) {
                    this.showPresetQuestions();
                    this.hasInteracted = true;

                    // Log preset questions shown
                    this.logEvent('preset_questions_shown', {
                        questionsCount: labels[this.lang].presetQuestions.length
                    });
                }
            });

            this.inputField.addEventListener('input', () => {
                if (!this.hasInteracted && !this.hasSentFirstMessage) {
                    this.showPresetQuestions();
                    this.hasInteracted = true;

                    // Log preset questions shown
                    this.logEvent('preset_questions_shown', {
                        questionsCount: labels[this.lang].presetQuestions.length
                    });
                }
            });

            // Also open preset questions if user clicks in the messages area
            this.messagesContainer.addEventListener('click', () => {
                if (!this.hasInteracted && !this.hasSentFirstMessage) {
                    this.showPresetQuestions();
                    this.hasInteracted = true;

                    // Log preset questions shown
                    this.logEvent('preset_questions_shown', {
                        questionsCount: labels[this.lang].presetQuestions.length
                    });
                }
            });

            // Click outside to close
            document.addEventListener('click', (e) => {
                if (this.isOpen && !this.chatElement.contains(e.target)) {
                    this.closeChat();
                }
            });
        }

        // Open chat window
        openChat() {
            this.isOpen = true;
            this.chatWindow.classList.add('open');
            this.chatBubble.style.display = 'none';
                this.showPresetQuestions();


            // Reset interaction state when reopening
            this.hasInteracted = false;
            this.hasSentFirstMessage = false;


            // Log chat opened
            this.logEvent('chat_opened', {
                openTime: new Date().toISOString()
            });

            // Show welcome message immediately
            this.showWelcomeMessage();

            setTimeout(() => {
                this.inputField.focus();
            }, 100);
        }

        // Close chat window
        closeChat() {
            this.isOpen = false;
            this.chatWindow.classList.remove('open');
            this.chatBubble.style.display = 'flex';
            // Reset interaction state when closing
            this.hasInteracted = false;
            this.hasSentFirstMessage = false;
            // Clear messages when closing
            this.messagesContainer.innerHTML = '';
            this.hidePresetQuestions();

            // Log chat closed
            this.logEvent('chat_closed', {
                closeTime: new Date().toISOString()
            });
        }

        // Send message via Socket.IO
        sendMessage() {
            const message = this.inputField.value.trim();
            if (!message || this.sendButton.disabled) return;

            // Hide preset questions after first message
            this.hidePresetQuestions();

            // Append user text to the chat log
            this.addMessage(message, 'user');
            this.inputField.value = '';
            this.sendButton.disabled = true;

            // Log user message
            this.logEvent('user_message', {
                message: message,
                messageLength: message.length,
                isFirstMessage: !this.hasSentFirstMessage
            });

            // Show typing indicator
            this.showTypingIndicator();

            // Emit userMessage via Socket.IO
            this.socket.emit('userMessage', {
                msg: message,
                lang: this.lang
            });

            this.hasSentFirstMessage = true;
        }

        // Add message to chat log
        addMessage(text, type) {
            const messageDiv = document.createElement('div');
            messageDiv.className = `daisho-message ${type}`;
            messageDiv.textContent = text;

            this.messagesContainer.appendChild(messageDiv);
            this.messagesContainer.scrollTop = this.messagesContainer.scrollHeight;
        }

        // Show typing indicator
        showTypingIndicator() {
            this.hideTypingIndicator();

            const ui = labels[this.lang];
            const typingDiv = document.createElement('div');
            typingDiv.className = 'daisho-typing';
            typingDiv.innerHTML = `
                <span>${ui.typing}</span>
                <div class="daisho-typing-dots">
                    <div class="daisho-typing-dot"></div>
                    <div class="daisho-typing-dot"></div>
                    <div class="daisho-typing-dot"></div>
                </div>
            `;

            this.messagesContainer.appendChild(typingDiv);
            this.messagesContainer.scrollTop = this.messagesContainer.scrollHeight;
        }

        // Hide typing indicator
        hideTypingIndicator() {
            const typingIndicator = this.messagesContainer.querySelector('.daisho-typing');
            if (typingIndicator) {
                typingIndicator.remove();
            }
        }

        hidePresetQuestions() {
            if (this.presetQuestionsContainer) {
                this.presetQuestionsContainer.style.display = 'none';
            }
        }

        showPresetQuestions() {
            if (this.presetQuestionsContainer) {
                this.presetQuestionsContainer.style.display = 'flex';

                // Scroll to preset questions smoothly if overflowing
                setTimeout(() => {
                    this.presetQuestionsContainer.scrollIntoView({behavior: "smooth", block: "nearest"});
                }, 100);
            }
        }

        // Show welcome message
        showWelcomeMessage() {
            const ui = labels[this.lang];
            // If welcome message already present in messages, don't add again
            const existingWelcome = Array.from(this.messagesContainer.querySelectorAll('.daisho-message.bot'))
                .some(div => div.textContent === ui.welcomeMessage);
            if (existingWelcome) return;
            setTimeout(() => {
                this.addMessage(ui.welcomeMessage, 'bot');

                // Log welcome message shown
                this.logEvent('welcome_message_shown', {
                    message: ui.welcomeMessage
                });
            }, 250);
        }
    }

    // Initialize widget when DOM is ready
    function initWidget() {
        if (daishoChatWidget) return; // Prevent multiple instances

        daishoChatWidget = new DaishoChatWidget();

        // Expose globally for debugging
        window.daishoChatWidget = daishoChatWidget;
    }

    // Auto-initialize when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initWidget);
    } else {
        initWidget();
    }

})();